get_filename_component(_sdk_prefix "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(CMAKE_HOST_WIN32)
  set(CMAKE_C_COMPILER "${_sdk_prefix}/bin/clang-cl.exe" CACHE FILEPATH "")
  set(CMAKE_CXX_COMPILER "${_sdk_prefix}/bin/clang-cl.exe" CACHE FILEPATH "")
else()
  set(CMAKE_C_COMPILER "${_sdk_prefix}/bin/clang" CACHE FILEPATH "")
  set(CMAKE_CXX_COMPILER "${_sdk_prefix}/bin/clang++" CACHE FILEPATH "")
endif()
if(NOT _sdk_prefix IN_LIST CMAKE_PREFIX_PATH)
  list(PREPEND CMAKE_PREFIX_PATH "${_sdk_prefix}")
endif()
