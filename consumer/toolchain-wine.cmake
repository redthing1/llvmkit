set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)

foreach(variable LLVM_SDK MSVC_WINE_ROOT)
  if(NOT IS_DIRECTORY "$ENV{${variable}}")
    message(FATAL_ERROR "Export ${variable} as an absolute Linux directory path")
  endif()
endforeach()
set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/clang-cl-wine" CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/clang-cl-wine" CACHE FILEPATH "")
set(CMAKE_LINKER "$ENV{MSVC_WINE_ROOT}/bin/x64/link" CACHE FILEPATH "")
set(CMAKE_AR "$ENV{MSVC_WINE_ROOT}/bin/x64/lib" CACHE FILEPATH "")
set(CMAKE_RC_COMPILER "$ENV{MSVC_WINE_ROOT}/bin/x64/rc" CACHE FILEPATH "")
set(CMAKE_MT "$ENV{MSVC_WINE_ROOT}/bin/x64/mt" CACHE FILEPATH "")
list(PREPEND CMAKE_PREFIX_PATH "$ENV{LLVM_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
