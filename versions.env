# Release inputs. Change these together, then rebuild and run the portability suite.
BASE_IMAGE=docker.io/library/almalinux:9@sha256:3a3fa7f043b142bc8008c8b308d39b47d2c84008addcd52f9f9a7a82d2a90474
LLVM_VERSION=22.1.8
