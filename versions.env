REMILL_VERSION=6.0.1
REMILL_COMMIT=0e324aee8c67a63ec759ef379dcfafa0b3cb1448
LIEF_VERSION=0.17.6
LIEF_COMMIT=6f3594f27056b85df51d6ad1c4ca944840ad3612
# Lab LIEF keeps PE/COFF and ELF; enable optional families when a project needs them.
LIEF_MACHO=OFF
LIEF_ANDROID=OFF
LIEF_JSON=ON
GFLAGS_COMMIT=52e94563eba1968783864942fedf6e87e3c611f4
GLOG_COMMIT=7b134a5c82c0c0b5698bb6bf7a835b230c5638e4
GOOGLETEST_COMMIT=52eb8108c5bdec04579160ae17225d66034bd723
XED_COMMIT=dc6bdbe036515c7ef55d3b2d50bafc5232bfe534
MBUILD_COMMIT=7c4497f41f576b43a80bb0f8d8452bbcfd58b6e2
SLEIGH_COMMIT=7c6b7424467d0382a1303c278633e99b0d094d5b
ABI=linux-x86_64-glibc234
# A full LLVM developer SDK, including Clang and LLD. Use a semicolon-separated
# subset (for example X86;AArch64;ARM;Sparc;PowerPC) to trade target coverage for size.
LLVM_TARGETS=all
LLVM_PROJECTS='clang;lld'
LLVM_ASSERTIONS=ON
